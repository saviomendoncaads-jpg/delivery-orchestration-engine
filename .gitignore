# Dependencies
node_modules/
**/node_modules/

# Production builds
dist/
**/dist/
build/
**/build/
out/
**/out/

# Environment files
.env
.env.*
.env.local
# ...mas o template de exemplo (sem segredos) deve ser versionado:
!.env.example
!**/.env.example
# config de build do frontend (vars VITE_ são públicas no bundle — sem segredo):
!frontend/.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

