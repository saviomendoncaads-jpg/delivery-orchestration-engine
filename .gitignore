.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Database / local JSON state files in backend
**/*.migrated
**/*.json.migrated
backend/*.json
backend/src/*.json
!backend/package.json
!backend/tsconfig.json

