# ───────────────────────────────────────────────────────────────────────────
# Distre — Backend. Copie para `.env` e ajuste. NUNCA comite o .env real.
# ───────────────────────────────────────────────────────────────────────────

# Porta HTTP do backend.
PORT=5000

# ─── Segurança / Autenticação ──────────────────────────────────────────────
# Credenciais do administrador master. DEFINA EM PRODUÇÃO — se ADMIN_SENHA não
# for definida, o sistema usa uma senha padrão de desenvolvimento e loga um aviso.
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha-forte

# Allowlist de origens do CORS (lista separada por vírgula). Em produção, liste
# os domínios reais do painel. Use "*" apenas em desenvolvimento (não recomendado).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Gateway de Pagamento (Motor de Cobrança) ──────────────────────────────
# Driver ativo: MOCK (dev/seed, padrão) | ASAAS | STRIPE.
# Trocar o provedor = trocar esta variável (ver billing/gatewayFactory.ts).
PAYMENT_GATEWAY=MOCK

# --- Asaas (Pix/Boleto/Cartão no Brasil) ---
# Chave da API (Configurações → Integrações → API). Mantenha em segredo.
ASAAS_API_KEY=
# Ambiente: sandbox (padrão, p/ testes) | production.
ASAAS_ENV=sandbox
# (Opcional) sobrescreve a URL base da API.
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token de autenticação do WEBHOOK. Cadastre o MESMO valor no painel da Asaas
# (Configurações → Webhooks → Token de autenticação) e aqui. Sem ele, os
# webhooks são rejeitados (fail-closed) — aponte o webhook para:
#   POST https://SEU_DOMINIO/api/billing/webhooks/pagamento
ASAAS_WEBHOOK_TOKEN=

# --- Stripe (driver ainda não implementado) ---
STRIPE_SECRET=

# ─── Escala / Deploy multi-instância ───────────────────────────────────────
# (Opcional) Atrás de load balancer/reverse proxy: nº de proxies confiáveis para
# X-Forwarded-* (ex.: 1). Deixe vazio quando NÃO houver proxy na frente.
TRUST_PROXY=
# (Opcional) URL do Redis para propagar eventos do socket.io entre réplicas.
# Vazio = instância única (comportamento padrão). Ex.: redis://localhost:6379
REDIS_URL=
# Liga os workers singleton (webhook/dunning). Em multi-instância, deixe 'true'
# em UMA instância (worker) e 'false' nas demais (web). Default = true.
RUN_BACKGROUND_JOBS=true

# ─── Banco de Dados (SQL Server) ───────────────────────────────────────────
# Defaults preservam o dev local (localhost\SQLEXPRESS, GESTAO_DADOS, Autenticação
# Integrada do Windows). Em produção/nuvem, defina os parâmetros abaixo.
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=GESTAO_DADOS
# (Opcional) porta TCP, se o servidor não usar instância nomeada.
DB_PORT=
# Autenticação: deixe DB_USER/DB_PASSWORD vazios para usar Windows Integrated Auth.
# Preencha ambos para usar SQL Server Authentication (cloud/gerenciado).
DB_USER=
DB_PASSWORD=
# Criptografia da conexão (true em SQL gerenciado/Azure). Default: false.
DB_ENCRYPT=false
# Confiar no certificado do servidor (true em dev / cert self-signed). Default: true.
DB_TRUST_SERVER_CERT=true
