# ───────────────────────────────────────────────────────────────────────────
# Distre — Backend. Copie para `.env` e ajuste. NUNCA comite o .env real.
# ───────────────────────────────────────────────────────────────────────────

# Porta HTTP do backend.
PORT=5000

# ─── Segurança / Autenticação ──────────────────────────────────────────────
# Credenciais do administrador master. DEFINA EM PRODUÇÃO — se ADMIN_SENHA não
# for definida, o sistema usa uma senha padrão de desenvolvimento e loga um aviso.
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha-forte

# Allowlist de origens do CORS (lista separada por vírgula). Em produção, liste
# os domínios reais do painel. Use "*" apenas em desenvolvimento (não recomendado).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Gateway de Pagamento (Motor de Cobrança) ──────────────────────────────
# Driver ativo: MOCK (dev/seed, padrão) | ASAAS | STRIPE.
# Trocar o provedor = trocar esta variável (ver billing/gatewayFactory.ts).
PAYMENT_GATEWAY=MOCK

# --- Asaas (Pix/Boleto/Cartão no Brasil) ---
# Chave da API (Configurações → Integrações → API). Mantenha em segredo.
ASAAS_API_KEY=
# Ambiente: sandbox (padrão, p/ testes) | production.
ASAAS_ENV=sandbox
# (Opcional) sobrescreve a URL base da API.
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token de autenticação do WEBHOOK. Cadastre o MESMO valor no painel da Asaas
# (Configurações → Webhooks → Token de autenticação) e aqui. Sem ele, os
# webhooks são rejeitados (fail-closed) — aponte o webhook para:
#   POST https://SEU_DOMINIO/api/billing/webhooks/pagamento
ASAAS_WEBHOOK_TOKEN=

# --- Stripe (driver ainda não implementado) ---
STRIPE_SECRET=

# Observação: a conexão com o SQL Server hoje é fixa em database.ts
# (localhost\SQLEXPRESS, GESTAO_DADOS, Autenticação Integrada do Windows).
# Para deploy multi-ambiente, externalize esses parâmetros para variáveis aqui.
